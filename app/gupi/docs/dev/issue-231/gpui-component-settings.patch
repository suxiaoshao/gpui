+    fn reconcile_selection(
+        selected: SelectIndex,
+        pages: &[(usize, SettingPage)],
+        query: &str,
+        cx: &App,
+    ) -> SelectIndex {
+        if let Some((_, page)) = pages.iter().find(|(ix, _)| *ix == selected.page_ix) {
+            return SelectIndex {
+                page_ix: selected.page_ix,
+                group_ix: selected.group_ix.filter(|ix| {
+                    page.groups
+                        .get(*ix)
+                        .is_some_and(|group| group.is_match(query, cx))
+                }),
+            };
+        }
+        // Retain the selection through an empty result, so clearing the query
+        // can return to the same page without a second selection history.
+        pages.first().map_or(selected, |(ix, _)| SelectIndex {
+            page_ix: *ix,
+            group_ix: None,
+        })
+    }
