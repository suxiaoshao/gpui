+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::setting::{SettingGroup, SettingItem};
+    use gpui::TestAppContext;
+
+    fn item(keyword: &'static str) -> SettingItem {
+        SettingItem::render(|_, _, _| div()).keywords([keyword])
+    }
+
+    #[gpui::test]
+    fn selection_tracks_original_page_and_group_during_search(cx: &mut TestAppContext) {
+        cx.update(|cx| {
+            let settings = Settings::new("test")
+                .page(SettingPage::new("General").group(SettingGroup::new().item(item("language"))))
+                .page(
+                    SettingPage::new("Appearance")
+                        .group(SettingGroup::new().item(item("light")))
+                        .group(SettingGroup::new().title("Dark theme").item(item("dark"))),
+                );
+            let selected = SelectIndex {
+                page_ix: 1,
+                group_ix: Some(1),
+            };
+            let pages = settings.filtered_pages("dark", cx);
+            assert_eq!(pages.len(), 1);
+            assert_eq!(pages[0].0, 1);
+            // Keep the unfiltered field tree: original IDs must survive filtering.
+            assert_eq!(pages[0].1.groups.len(), 2);
+            let selected = Settings::reconcile_selection(selected, &pages, "dark", cx);
+            assert_eq!(selected.page_ix, 1);
+            assert_eq!(selected.group_ix, Some(1));
+            let pages = settings.filtered_pages("light", cx);
+            let selected = Settings::reconcile_selection(selected, &pages, "light", cx);
+            assert_eq!(selected.page_ix, 1);
+            assert_eq!(selected.group_ix, None);
+            let pages = settings.filtered_pages("", cx);
+            assert_eq!(
+                Settings::reconcile_selection(selected, &pages, "", cx).page_ix,
+                1
+            );
+        });
+    }
+
+    #[gpui::test]
+    fn search_falls_back_to_first_match_and_preserves_selection_when_empty(
+        cx: &mut TestAppContext,
+    ) {
+        cx.update(|cx| {
+            let settings = Settings::new("test")
+                .page(SettingPage::new("General").group(SettingGroup::new().item(item("language"))))
+                .page(SettingPage::new("Pi").group(SettingGroup::new().item(item("command"))));
+            let selected = SelectIndex {
+                page_ix: 1,
+                group_ix: None,
+            };
+            let empty = settings.filtered_pages("missing", cx);
+            assert!(empty.is_empty());
+            let selected = Settings::reconcile_selection(selected, &empty, "missing", cx);
+            assert_eq!(selected.page_ix, 1);
+            let all = settings.filtered_pages("", cx);
+            assert_eq!(
+                Settings::reconcile_selection(selected, &all, "", cx).page_ix,
+                1
+            );
+            let pages = settings.filtered_pages("language", cx);
+            assert_eq!(
+                Settings::reconcile_selection(selected, &pages, "language", cx).page_ix,
+                0
+            );
+        });
+    }
+}
